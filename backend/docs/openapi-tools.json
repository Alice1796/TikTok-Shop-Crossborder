    "/setOrder": {
      "post": {
        "tags": ["订单与交易"],
        "summary": "生成订单",
        "description": "这是为用户生成一笔新订单的接口。需要登录。可选传 lang、web_time。会先看用户余额是否至少 10、抢单状态（graborders）；再在运营时间内随机选一个符合余额的商品，插入订单并更新用户 order_total 等，同时写一条扣款类型的钱包流水（预扣）。若已有未完成订单会直接报错。",
        "operationId": "setOrder",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "lang": { "type": "string" },
                  "web_time": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "返回新订单信息（含订单号、商品、金额、佣金等）或余额不足/已有未完成订单等提示"
          }
        }
      }
    },
    "/commitOrder": {
      "post": {
        "tags": ["订单与交易"],
        "summary": "提交订单（完成订单并分佣）",
        "description": "这是用户「完成」一笔订单的接口，即确认订单、扣款、返佣、解冻等。必须传 order_id。需要登录且订单必须属于当前用户、状态为待支付。会扣用户余额、写钱包流水、按等级和上级关系做多级返佣、更新订单状态等。适合在用户点击「提交订单」或「完成任务」时调用。",
        "operationId": "commitOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["order_id"],
                "properties": {
                  "order_id": { "type": "integer", "description": "订单 ID，必填" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "提交成功或余额不足、订单状态错误等"
          }
        }
      }
    },
    "/getOrderList": {
      "post": {
        "tags": ["订单与交易"],
        "summary": "订单列表",
        "description": "这是获取当前用户订单列表的接口。传 page 分页，可选 status（按状态筛选）、web_time、lang。返回订单与商品名称、图片、金额、佣金等。需要登录。",
