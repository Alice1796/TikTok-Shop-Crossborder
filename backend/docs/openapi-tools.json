          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "page": { "type": "integer", "default": 1 },
                  "web_time": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "流水列表，带 total、last_page"
          }
        }
      }
