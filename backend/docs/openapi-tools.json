                  "web_time": { "type": "string" },
                  "lang": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "单条订单详情"
          }
        }
      }
    },
    "/getList": {
      "get": {
        "tags": ["抽奖"],
